    def plot_map(self):
        for prop, value in self.__dict__.items():
            if isinstance(value, pd.DataFrame):
                min_value = 0
                if prop not in self.sed_ids_colors:
                    min_value = 0
                    max_value = 1
                else:
                    if prop == "THICKNESS":
                        min_value = 0
                    max_value = self.sed_ids_colors[prop]

                # Colormap personalizado
                img = Image.open(r"C:\Users\52598542843\Documents\Sedsimple\cor.png").convert('RGB')
                img_np = np.array(img)
                x_center = img_np.shape[1] // 2
                color_column = img_np[:, x_center, :]
                colors = np.unique(color_column, axis=0)
                colors_norm = colors / 255.0
                custom_cmap = ListedColormap(colors_norm, name='custom_colormap')

                # Células com valor médio
                cell_data = 0.25 * (
                        value.astype(float).values[:-1, :-1] +
                        value.astype(float).values[1:, :-1] +
                        value.astype(float).values[:-1, 1:] +
                        value.astype(float).values[1:, 1:]
                )

                # Coordenadas originais
                x_nodes = value.columns.to_numpy(dtype=float)
                y_nodes = value.index.to_numpy(dtype=float)
                dx = np.diff(x_nodes)[0]
                dy = np.diff(y_nodes)[0]

                X, Y = np.meshgrid(x_nodes, y_nodes)

                # Margens
                margin_x = 4
                margin_y = .5
                x_full = np.arange(x_nodes[0] - margin_x * dx, x_nodes[-1] + (margin_x + 1) * dx, dx)
                y_full = np.arange(y_nodes[0] - margin_y * dy, y_nodes[-1] + (margin_y + 1) * dy, dy)

                fig, ax = plt.subplots(figsize=(10, 8))

                # Grid externo (somente moldura visual)
                for i in range(len(x_full) - 1):
                    for j in range(len(y_full) - 1):
                        x0, x1 = x_full[i], x_full[i + 1]
                        y0, y1 = y_full[j], y_full[j + 1]
                        ax.add_patch(
                            patches.Rectangle((x0, y0), x1 - x0, y1 - y0,
                                              linewidth=0, edgecolor='none', facecolor='none')
                        )

                # Plot central do mapa
                extent = (x_nodes[0], x_nodes[-1], y_nodes[0], y_nodes[-1])
                # c = ax.imshow(cell_data[::-1], origin='upper', cmap=custom_cmap,
                #               extent=extent, vmin=min_value, vmax=max_value)
                levels_ = np.linspace(min_value, max_value, 16)
                c = ax.contourf(X, Y, value.astype(float), levels=levels_, cmap=custom_cmap, vmin=min_value, vmax=max_value)

                # Poços
                for well, (x, y) in self.wells.items():
                    ax.plot(x, y, "o", color="black", markersize=5)
                    ax.text(x, y, well, color="magenta", fontsize=12, fontweight="bold")

                # # Borda vermelha do mapa
                # ax.add_patch(
                #     patches.Rectangle(
                #         (x_nodes[0], y_nodes[0]),
                #         x_nodes[-1] - x_nodes[0],
                #         y_nodes[-1] - y_nodes[0],
                #         linewidth=2, edgecolor='red', facecolor='none'
                #     )
                # )

                # Barra de cores
                cb = fig.colorbar(c, ax=ax, shrink=0.8)
                cb.set_label(f"{prop} (Sediment Proportion [/])")

                # Ajusta os limites e remove labels
                ax.set_xlim(x_full[0], x_full[-1])
                ax.set_ylim(y_full[0], y_full[-1])
                ax.set_xlabel("")
                ax.set_ylabel("")
                ax.tick_params(axis='both', which='both', direction='in', labelsize=8)

                x_ticks = x_full[4::8]
                y_ticks = y_full[4::8]

                # Reduz a quantidade de valores nos eixos
                ax.set_xticks(x_full[4::8])
                ax.set_yticks(y_full[4::8])
                ax.set_xticklabels([f"{int(x):,}" for x in x_full[4::8]], rotation=0, fontsize=10)
                ax.set_yticklabels([f"{int(y):,}" for y in y_full[4::8]], rotation=90, fontsize=10)

                # Ticks superiores
                ax.tick_params(top=True, labeltop=True)
                ax.set_xticks(x_ticks, minor=False)
                ax.set_xticklabels([f"{int(x):,}" for x in x_ticks], rotation=0, fontsize=10)

                # Ticks à direita
