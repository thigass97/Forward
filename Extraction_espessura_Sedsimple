class SSAverageMap(Properties):
    def __init__(self, sed_colors, wells):
        super().__init__()
        self.sed_ids_colors = sed_colors
        self.wells = wells

    def get_propthickness(self):
        dict_new_variables = {}
        max_value_thick = 0
        for key, value in self.__dict__.items():
            if key != "THICKNESS" and isinstance(value, pd.DataFrame):
                product_name = f"{key}_THICKNESS"
                product_var = value * self.THICKNESS if hasattr(self, "THICKNESS") else None
                dict_new_variables[product_name] = product_var
        for new_var, variable in dict_new_variables.items():
            max_var = variable.max().max()
            max_value_thick = max_var if max_var > max_value_thick else max_value_thick
            setattr(self, new_var, variable)
        setattr(self, "max_value_for_thickness_sed", max_value_thick)


class GPMData(Properties):
    def __init__(self, filepath, sed_colors, wells, domain, **kwargs):
        super().__init__()
        self.path = filepath
        self.sed_ids_colors = sed_colors
        self.wells = wells
        self.index_df = domain[0]
        self.column_df = domain[1]
        if kwargs:
            self.x0 = kwargs["x0"]
            self.y0 = kwargs["y0"]

    def get_data(self):
        df = pd.read_csv(
            self.path,
            delim_whitespace=True,
            header=0,
            skiprows=0
        )

        x_coord = df["X[m]"].values
        y_coord = df["Y[m]"].values
        thickkness_values = df["Thickness[m]"]

        x_coord_grid = np.unique(x_coord)
        y_coord_grid = np.unique(y_coord)

        thickness_grid = np.zeros((len(y_coord_grid), len(x_coord_grid)))
        for k in range(len(thickkness_values)):
            xi = np.where(x_coord_grid == x_coord[k])[0][0]
            yi = np.where(y_coord_grid == y_coord[k])[0][0]
            thickness_grid[yi, xi] = thickkness_values[k]

        thickness_gpm_df = pd.DataFrame(thickness_grid)  #[::-1]
        thickness_gpm_df = thickness_gpm_df.loc[::2, ::2]
        # thickness_gpm_df = thickness_gpm_df.set_index(self.index_df[:-1])
        thickness_gpm_df = thickness_gpm_df.set_index(y_coord_grid[::2])
        # thickness_gpm_df.columns = self.column_df[:-1]
        thickness_gpm_df.columns = x_coord_grid[::2]
        setattr(self, "THICKNESS", thickness_gpm_df)


